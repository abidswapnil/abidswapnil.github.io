---
const { data } = Astro.props
import { Icon } from "astro-icon/components";

---

<a href={data.href || data.github}  target="_blank">
  <div class="h-95 p-5 
      group
      relative
      md:border-b
      md:border-r
      md:border-b-card-border
      border-r-card-border
      ring
      md:ring-0
      ring-plate-ring
      shadow-md
      md:shadow-lg
      flex-1
      md:hover:shadow-shadow
      rounded-sm
      bg-card
      transition
      ease-out 
      duration-300 
      md:hover:-translate-y-1
      md:hover:translate-x-1 
      cursor-pointer ">
    <header>
      <div class="flex justify-between text-sm text-text-mini font-semibold">
        <span>{data.date} </span>
        <span>{data.category}</span>
      </div>
      <hr class="h-px w-full border-0 bg-hr" />
    </header>
    <p class="text-text-bright text-md mb-2 mt-2 font-semibold">{data.title}</p>

    <div class="mt-2 w-full mb-4">
      <p set:html={data.description} class="text-sm "></p>
    </div>
    <footer class="absolute bottom-3 left-5 right-5 text-sm">
      <div class="text-text-mini text-sm flex items-center">
        <span>{data.tools.join(", ")}</span>
        <Icon name={`lucide:${data.icon}`} class="h-5 w-5 ml-auto group-hover:text-text-hover group-hover:duration-300 group-hover:transition-colors" />
      </div>
    </footer>
  </div>
</a>