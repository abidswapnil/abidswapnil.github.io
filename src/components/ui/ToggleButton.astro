---
const { checked = false } = Astro.props
---

<label class="fixed top-3 left-3 z-50 inline-flex items-center gap-3 cursor-pointer">
  <div class="relative">
    <input
      id="theme-toggle"
      type="checkbox"
      class="peer sr-only"
      checked={checked}
    />

    <div
      class="h-7 w-12 justify-between flex items-center text-sm rounded-full border border-border bg-plate transition-colors duration-300 peer-checked:bg-card"
    >
     <span class="p-1 text-unchecked font-bold">G</span>
     <span class="p-1 text-checked font-bold">N</span>
    </div>

    <div
      class="absolute top-1 left-1 h-5 w-5 rounded-full bg-white shadow-md transition-transform duration-300 peer-checked:translate-x-5"
    >
    </div>
  </div>
</label>

<script>
  const toggle = document.getElementById('theme-toggle');

  function syncToggle() {
    if (!toggle) return;
    toggle.checked = document.documentElement.getAttribute('data-theme') === 'blue';
  }

  syncToggle();

  toggle?.addEventListener('change', () => {
    if (toggle.checked) {
      document.documentElement.setAttribute('data-theme', 'blue');
      localStorage.setItem('theme', 'blue');
    } else {
      document.documentElement.removeAttribute('data-theme');
      localStorage.removeItem('theme');
    }
  });

  document.addEventListener('astro:after-swap', syncToggle);
</script>
