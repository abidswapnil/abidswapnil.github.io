---
const { checked = false } = Astro.props
---

<label class="fixed inline-flex cursor-pointer top-3 left-3 z-1 items-center">
  <input
    id="theme-toggle"
    type="checkbox"
    class="peer sr-only"
    checked={checked}
  />

  <div
    class="h-7 w-12 rounded-full border border-border bg-plate transition-colors duration-300 peer-checked:bg-text-hover"
  ></div>

  <div
    class="absolute left-1 top-1 h-5 w-5 rounded-full bg-white shadow transition-transform duration-300 peer-checked:translate-x-5"
  ></div>
</label>

<script>
  const toggle = document.getElementById('theme-toggle');

  function syncToggle() {
    if (!toggle) return;
    toggle.checked = document.documentElement.getAttribute('data-theme') === 'blue';
  }

  // reflect actual saved theme on load (overrides the server-rendered `checked` prop)
  syncToggle();

  toggle?.addEventListener('change', () => {
    if (toggle.checked) {
      document.documentElement.setAttribute('data-theme', 'blue');
      localStorage.setItem('theme', 'blue');
    } else {
      document.documentElement.removeAttribute('data-theme');
      localStorage.removeItem('theme');
    }
  });

  // re-sync if using View Transitions (astro:after-swap) — harmless no-op otherwise
  document.addEventListener('astro:after-swap', syncToggle);
</script>
