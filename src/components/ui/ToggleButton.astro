---
const { checked = false } = Astro.props
---

<label class="relative inline-flex cursor-pointer top-3 left-3 items-center">
  <input
    id="theme-toggle"
    type="checkbox"
    class="peer sr-only"
    checked={checked}
  />

  <div
    class="h-7 w-12 rounded-full border border-border bg-plate transition-colors duration-300 peer-checked:bg-text-hover"
  ></div>

  <div
    class="absolute left-1 top-1 h-5 w-5 rounded-full bg-white shadow transition-transform duration-300 peer-checked:translate-x-5"
  ></div>
</label>

<script>
  const toggle = document.getElementById("theme-toggle")
  const root = document.documentElement

  if (toggle instanceof HTMLInputElement) {
    toggle.addEventListener("change", () => {
      console.log(toggle.checked)
    })
  }

  const theme = localStorage.getItem("theme") ?? "dark"
  console.log(toggle)
</script>