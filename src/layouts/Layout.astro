---
import Drawer from "../components/layout/Drawer.astro";
import Sidebar from "../components/layout/Sidebar.astro";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import  "../styles/global.css";

import Social from "../components/layout/Social.astro";
import { ClientRouter } from "astro:transitions";
import ToggleButton from "../components/ui/ToggleButton.astro";

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <script is:inline>
      const saved = localStorage.getItem('theme');
      if (saved) document.documentElement.setAttribute('data-theme', saved);
    </script>
    <ClientRouter />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <link rel="preload" href="/fonts/Inter-VariableFont_opsz,wght.ttf" as="font" type="font/ttf" crossorigin/>
  </head>

  <body class="bg-background min-h-screen scrollbar-thin overflow-x-hidden ">
    <Drawer />
    <ToggleButton />
    <div class="flex">
      <Sidebar />
      <Navbar />
      <div class="md:fixed hidden bottom-4 left-4">
        <Social />
      </div>

      <main class="
             w-full
             xl:ml-[13%]
             max-w-7xl
             mx-auto
             font-serif
             text-md
             transition-colors 
             duration-500 
             ease-in-out
             lg:text-base 
             leading-7 
             font-normal 
             tracking-normal 
             text-text-body
             antialiased 
             md:subpixel-antialiased">
        <slot />
      </main>
    </div>
    <Footer />
  </body>
</html>


